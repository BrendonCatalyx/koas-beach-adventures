<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
{%- set pageTitle = title + " — " + site.siteName if title else site.siteName %}
{%- set pageDesc = description or site.defaultDescription %}
{%- set pageUrl = site.siteUrl + page.url %}
{%- set pageImage = site.siteUrl + (image or site.defaultOgImage) %}
<title>{{ pageTitle }}</title>
<meta name="description" content="{{ pageDesc }}">
<link rel="canonical" href="{{ pageUrl }}">

<meta property="og:title" content="{{ pageTitle }}">
<meta property="og:description" content="{{ pageDesc }}">
<meta property="og:type" content="{{ ogType or 'website' }}">
<meta property="og:url" content="{{ pageUrl }}">
<meta property="og:image" content="{{ pageImage }}">
<meta property="og:site_name" content="{{ site.siteName }}">

<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ pageTitle }}">
<meta name="twitter:description" content="{{ pageDesc }}">
<meta name="twitter:image" content="{{ pageImage }}">

{% if jsonld %}
<script type="application/ld+json">{{ jsonld | safe }}</script>
{% endif %}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@500;600;700&family=Nunito:wght@400;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/styles.css">
{% if extraStyles %}<style>{{ extraStyles | safe }}</style>{% endif %}
</head>
<body>

{% include "partials/header.njk" %}

<main>
{{ content | safe }}
</main>

{% include "partials/footer.njk" %}

<script src="/app.js"></script>
{% if extraScripts %}<script>{{ extraScripts | safe }}</script>{% endif %}
</body>
</html>
