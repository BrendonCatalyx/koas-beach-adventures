---
layout: layouts/base.njk
pagination:
  data: destinations
  size: 1
  alias: destination
permalink: "/world/{{ destination.slug }}/"
eleventyComputed:
  title: "{{ destination.name | safe }}"
  description: "{{ destination.hook | safe }}"
  ogType: website
  jsonld: >-
    {% if destination.status != "planned" %}{"@context":"https://schema.org","@type":"Place","name":{{ destination.name | dump | safe }},"description":{{ destination.hook | dump | safe }}}{% endif %}
---
{% from "partials/related.njk" import block as relatedBlock %}
{% from "partials/video-card.njk" import card as videoCard %}
{% from "partials/art.njk" import destination as destinationArt %}
<div class="wrap">
  <a href="/world/" class="btn ghost small" style="margin-top:24px;">← All destinations</a>

  {% set friend = findBySlug(characters, destination.friendSlug) if destination.friendSlug else null %}

  <div class="detail-hero">
    <div class="detail-art reveal in">
      <div class="art-frame">{{ destinationArt(destination) }}</div>
    </div>
    <div class="detail-copy reveal in">
      <span class="eyebrow">{{ destination.region }}</span>
      <h1>{{ destination.name }}</h1>
      {% if destination.welcome and friend %}
      <div class="friend-welcome">
        {% set cutout = characterCutoutPath(friend) %}
        {% if cutout %}<img class="friend-welcome-face" src="{{ cutout }}" alt="{{ friend.name }}">{% endif %}
        <p class="friend-welcome-speech">{{ destination.welcome }}</p>
      </div>
      {% else %}
      <p class="bio">{{ destination.hook }}</p>
      {% endif %}
    </div>
  </div>

  {% if destination.status == "planned" %}
    <p style="margin:24px 0;">This part of the world hasn't been explored yet — check back when the book publishes.</p>
  {% else %}
    {% if destination.culture %}
    <h3>Places we'll visit</h3><p>{{ destination.culture }}</p>
    {% endif %}
    {% if destination.wildlife and destination.wildlife.length %}
    <h3>Animals we'll meet</h3>
    <ul class="fun-facts">{% for w in destination.wildlife %}<li>{{ w }}</li>{% endfor %}</ul>
    {% endif %}
    {% if destination.didYouKnow %}
    <div class="dyk" style="margin-top:24px;">
      <div class="badge-icon">{% shell %}</div>
      <div><h3>Things we'll learn</h3><p>{{ destination.didYouKnow }}</p></div>
    </div>
    {% endif %}
    <div class="destination-actions reveal in" style="display:flex;gap:12px;flex-wrap:wrap;margin-top:28px;">
      {% set destBook = findBySlug(books, destination.bookSlug) if destination.bookSlug else null %}
      {% if destBook and destBook.status == "live" %}<a href="/books/{{ destBook.slug }}/" class="btn small">📖 Read the story</a>{% endif %}
      <a href="/activities/#colouring" class="btn ghost small">🎨 Colour with us</a>
      {% if friend %}<a href="/crew/{{ friend.slug }}/" class="btn ghost small">👋 Meet {{ friend.name }}</a>{% endif %}
    </div>
  {% endif %}

  {% set relatedVideos = videosFor(videos, { destinationSlug: destination.slug }) %}
  {% if relatedVideos.length %}
  <h3 style="margin-top:32px;">Watch {{ destination.name }}</h3>
  <div class="video-row">
    {% for v in relatedVideos %}{{ videoCard(v, characters) }}{% endfor %}
  </div>
  {% endif %}

  {{ relatedBlock("destination", destination.slug, characters, destinations, books) }}
</div>
